{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["hnd1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/activity",
      "destination": "/api?path=activity"
    },
    {
      "source": "/api/admin/bans",
      "destination": "/api?path=admin/bans"
    },
    {
      "source": "/api/admin/chat-reports",
      "destination": "/api?path=admin/chat-reports"
    },
    {
      "source": "/api/announcements",
      "destination": "/api?path=announcements"
    },
    {
      "source": "/api/announcements/:id",
      "destination": "/api?path=announcements/:id"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api?path=auth/me"
    },
    {
      "source": "/api/auth/sign-in",
      "destination": "/api?path=auth/sign-in"
    },
    {
      "source": "/api/chat",
      "destination": "/api?path=chat"
    },
    {
      "source": "/api/events",
      "destination": "/api?path=events"
    },
    {
      "source": "/api/events/:id",
      "destination": "/api?path=events/:id"
    },
    {
      "source": "/api/follows",
      "destination": "/api?path=follows"
    },
    {
      "source": "/api/notifications",
      "destination": "/api?path=notifications"
    },
    {
      "source": "/api/project-interactions",
      "destination": "/api?path=project-interactions"
    },
    {
      "source": "/api/profiles/me",
      "destination": "/api?path=profiles/me"
    },
    {
      "source": "/api/profiles/lookup",
      "destination": "/api?path=profiles/lookup"
    },
    {
      "source": "/api/profiles/:id",
      "destination": "/api?path=profiles/:id"
    },
    {
      "source": "/api/projects",
      "destination": "/api?path=projects"
    },
    {
      "source": "/api/projects/:id/view",
      "destination": "/api?path=projects/:id/view"
    },
    {
      "source": "/api/projects/:id",
      "destination": "/api?path=projects/:id"
    },
    {
      "source": "/((?!api(?:/|$)|src/|@vite/|@react-refresh|@id/|@fs/|node_modules/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}

